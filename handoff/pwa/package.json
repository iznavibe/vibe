{
	"name": "vibe-phone",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.4.1",
	"scripts": {
		"predev": "node scripts/copy-ort.mjs && node scripts/copy-whisper.mjs",
		"dev": "vite --port 8088 --host",
		"prebuild": "node scripts/copy-ort.mjs && node scripts/copy-whisper.mjs",
		"build": "tsc && vite build",
		"preview": "vite preview --port 8088 --host",
		"wasm": "node scripts/fetch-wasm.mjs",
		"test": "node --test \"tests/*.test.mjs\"",
		"ort": "node scripts/copy-ort.mjs && node scripts/copy-whisper.mjs"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fugood/whisper.node": "1.2.0-rc.0",
		"@huggingface/transformers": "^4.2.0",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"idb": "^8.0.3",
		"lucide-react": "^0.563.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.3",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
